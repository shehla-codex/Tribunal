# Tribunal Environment Configuration
# Copy this file to .env.local and configure your keys.
# Note: Demo Mode works completely offline with zero API keys.

# LLM Provider Configuration (gemini)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# Google Gemini API Key (starts with AQ. or AIza)
# Obtain from https://aistudio.google.com/
LLM_API_KEY=

# Optional: GitHub Personal Access Token (for higher rate limits on GitHub Codebase Mode)
GITHUB_TOKEN=
